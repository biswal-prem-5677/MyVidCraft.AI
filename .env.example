# Copy to `.env` and fill in. All settings are optional — the app runs without
# any of them, using an offline template generator instead of the LLM.

# --- LLM (Phase 1 brain + script engines) ---
# Without a key the script/brain engines fall back to deterministic templates,
# which produce valid but generic output. Get a key at https://console.anthropic.com
MYVIDCRAFT_ANTHROPIC_API_KEY=

# The SDK's own ANTHROPIC_API_KEY is also honoured if the above is unset.
# ANTHROPIC_API_KEY=

# Model + generation settings (defaults shown).
# MYVIDCRAFT_LLM_MODEL=claude-opus-5
# MYVIDCRAFT_LLM_MAX_TOKENS=16000
# MYVIDCRAFT_LLM_MAX_RETRIES=3
# MYVIDCRAFT_LLM_TIMEOUT_S=240

# Set to false to force the offline template path even with a key present.
# MYVIDCRAFT_LLM_ENABLED=true

# --- Speech synthesis ---
# REQUIRED for the voice stage. Unlike the LLM there is no offline fallback:
# the previous local engine (Windows SAPI) was removed because it could not run
# in a container and serialised every turn behind one process-wide lock.
# Get a key at https://platform.openai.com
MYVIDCRAFT_OPENAI_API_KEY=

# The SDK's own OPENAI_API_KEY is also honoured if the above is unset.
# OPENAI_API_KEY=

# Name registered in `workers.media.tts.registry`. An unknown name raises at the
# start of the voice stage rather than silently using a default.
# MYVIDCRAFT_TTS_ENGINE=openai

# tts-1 honours `speed`, which is how the dialogue schema's pace_wpm reaches the
# audio. tts-1-hd trades cost for fidelity.
# MYVIDCRAFT_TTS_MODEL=tts-1
# MYVIDCRAFT_TTS_MAX_RETRIES=2
# MYVIDCRAFT_TTS_TIMEOUT_S=60

# --- Video composition ---
# Name registered in `workers.media.video.registry`. The default compositor draws
# frames in pure Python and needs only FFmpeg to mux; a GPU avatar backend
# registers under its own name.
# MYVIDCRAFT_VIDEO_ENGINE=slideshow

# 16:9 by default. The 9:16 shorts variants are a Phase 4 export concern, not a
# setting here. Odd values are rounded down: yuv420p requires even dimensions.
# MYVIDCRAFT_VIDEO_WIDTH=1280
# MYVIDCRAFT_VIDEO_HEIGHT=720
# MYVIDCRAFT_VIDEO_FPS=25

# --- Infrastructure ---
# SQLite is the default for local dev and tests. It is single-writer, so two
# concurrent runs serialise on it — docker-compose uses Postgres instead:
#   postgresql+psycopg2://myvidcraft:myvidcraft@db:5432/myvidcraft
# Schema changes go through `alembic upgrade head`, never create_all.
# MYVIDCRAFT_DATABASE_URL=sqlite:///./data/myvidcraft.sqlite3
# MYVIDCRAFT_ARTIFACTS_DIR=./data/artifacts
# Redis is optional: with no broker reachable, runs execute in-process.
# MYVIDCRAFT_REDIS_URL=redis://localhost:6379/0

# FFmpeg is discovered on PATH and is optional everywhere it is used. Without it
# a run still completes: no episode.mp3, and video degrades to a storyboard plus
# captions.srt with no mp4.
