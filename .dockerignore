# Keep the build context small and the image free of host state.
#
# `data/` matters most: it holds the dev SQLite database and every rendered
# artifact, which is both large and machine-specific. Copying it in would bake
# one developer's runs into the image.
data/
*.sqlite3

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The web app is not containerised yet — it is a Next.js frontend that will get
# its own image when Gate 2 adds auth and a real UI.
apps/web/
node_modules/
.next/

tests/
docs/
*.md
.env
.env.*
!.env.example
